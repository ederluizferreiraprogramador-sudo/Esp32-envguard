{
  "compilerOptions": {
    "strict": true, "noEmit": true, "target": "es2022", "module": "esnext", "moduleResolution": "bundler",
    "skipLibCheck": true, "lib": ["es2022", "dom"], "noUncheckedIndexedAccess": true,
    "paths": { "@/lib/*": ["./src/lib/*"], "@/data/*": ["./src/data/*"] }
  },
  "include": ["src/lib/**/*.ts", "src/data/**/*.ts", "src/*.test.ts"],
  "exclude": ["src/lib/accounts.ts", "src/lib/heroTint.ts"]
}
